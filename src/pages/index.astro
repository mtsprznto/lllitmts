---
import Layout from "@/layouts/Layout.astro";

import HeroKeyBackground from "@/assets/fondo.jpg";
import PricingSection from "@/components/PricingSection.astro";
import VideoDemo from "@/components/VideoDemo.astro";
import SectionInfo from "@/components/SectionInfo.astro";
import HomePrincipal from "@/components/HomePrincipal.astro";
import AlbumPromo from "@/components/AlbumPromo.astro";
import GalleryPromo from "@/components/GalleryPromo.astro";
import Footer from "@/components/Footer.astro";
import LET from "@/assets/let.png";
import HeaderHome from "@/components/HeaderHome.astro";
---

<Layout
  canonicalUrl="https://lllitmts.vercel.app/"
>
  <HeaderHome
    title_button_about="About this"
    button_id_about="go_to_about"
    title_button_videos="Videos"
    button_id_videos="go_to_videos"
    title_button_price="Precios"
    button_id_price="go_to_price"
    title_button_album="Álbum"
    button_id_album="go_to_album"
  />
  <HomePrincipal HeroKeyBackground={HeroKeyBackground} LET={LET} />
  <SectionInfo LET={LET} />
  <VideoDemo />
  <GalleryPromo />
  <PricingSection />
  <AlbumPromo />
  <!-- FAQ — Y2K Brutalist (tokens + neon) -->
  <section
    id="faq"
    class="bg-[var(--surface)] text-[var(--ink)] px-5 sm:px-8 py-20 sm:py-28"
  >
    <div class="mx-auto max-w-3xl">
      <!-- Header editorial -->
      <header class="border-b-2 border-[var(--line)] pb-8">
        <div class="flex items-center justify-between gap-4">
          <p class="font-mono text-[10px] font-bold uppercase tracking-[0.25em] text-neon">
            [ FAQ / Dudas ]
          </p>
          <p class="hidden font-mono text-[10px] uppercase tracking-[0.25em] text-[var(--muted)] sm:block">
            3 preguntas · respuestas directas
          </p>
        </div>
        <h2
          id="faq-title"
          class="mt-5 text-[clamp(2.25rem,7vw,4.5rem)] font-bold uppercase leading-[0.9] tracking-tighter"
        >
          Preguntas<br />frecuentes<span class="text-neon">.</span>
        </h2>
      </header>

      <!-- Preguntas -->
      <div class="divide-y-2 divide-[var(--line)]">
        <div class="faq-item group py-6">
          <h3 class="flex items-baseline gap-3 sm:gap-4">
            <span class="shrink-0 font-mono text-xs font-bold tabular-nums text-neon">[01]</span>
            <span class="font-bold uppercase tracking-tight text-base sm:text-lg transition-colors duration-150 group-hover:bg-neon group-hover:text-black">
              ¿Quién es LLLIT?
            </span>
          </h3>
          <p class="mt-3 pl-8 sm:pl-12 text-sm sm:text-base leading-relaxed text-[var(--muted)]">
            LLLIT es un proyecto de música electrónica y visuales en vivo de Chile. Minimal dub, ambient psicodélico y experimental.
          </p>
        </div>

        <div class="faq-item group py-6">
          <h3 class="flex items-baseline gap-3 sm:gap-4">
            <span class="shrink-0 font-mono text-xs font-bold tabular-nums text-neon">[02]</span>
            <span class="font-bold uppercase tracking-tight text-base sm:text-lg transition-colors duration-150 group-hover:bg-neon group-hover:text-black">
              ¿Qué es Inesperado contratiempo?
            </span>
          </h3>
          <p class="mt-3 pl-8 sm:pl-12 text-sm sm:text-base leading-relaxed text-[var(--muted)]">
            Es el nuevo álbum de LLLIT (2026) con 5 tracks que exploran minimal dub, ambient psicodélico y experimental. Out Sept 4 en Bandcamp.
          </p>
        </div>

        <div class="faq-item group py-6">
          <h3 class="flex items-baseline gap-3 sm:gap-4">
            <span class="shrink-0 font-mono text-xs font-bold tabular-nums text-neon">[03]</span>
            <span class="font-bold uppercase tracking-tight text-base sm:text-lg transition-colors duration-150 group-hover:bg-neon group-hover:text-black">
              ¿Ofrece LLLIT servicios de mapping?
            </span>
          </h3>
          <p class="mt-3 pl-8 sm:pl-12 text-sm sm:text-base leading-relaxed text-[var(--muted)]">
            Sí, mapping visual en vivo con TouchDesigner, con o sin proyector. Ideal para eventos, fiestas y presentaciones. Consultá precios en{" "}
            <a
              href="/prices"
              class="font-bold text-neon underline decoration-neon/40 underline-offset-4 transition-colors duration-150 hover:decoration-neon"
            >
              /prices
            </a>
            .
          </p>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-10 border-2 border-[var(--line)]">
        <a
          href="/formulario"
          class="faq-cta group flex items-center justify-between gap-4 px-5 py-4 font-mono text-xs sm:text-sm font-bold uppercase tracking-widest transition-colors duration-150 hover:bg-neon hover:text-black"
        >
          <span>¿Otra duda? Escríbenos</span>
          <span class="transition-transform duration-150 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <style>
    @media (prefers-reduced-motion: reduce) {
      .faq-item span,
      .faq-cta span {
        transition: none;
      }
    }
  </style>

  <Footer />
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "VideoObject",
      "name": "LLLIT — Demo Mapping Visual TouchDesigner",
      "description": "Demostraciones de mapping visual en vivo producidas con TouchDesigner por LLLIT.",
      "thumbnailUrl": "https://lllitmts.vercel.app/images/album/cover-small.webp",
      "contentUrl": "https://6bq1d1k7on.ufs.sh/f/78XjxKUMCV2ao5NjdlBxwDBNugMZPXJEvp0y4TAnQUIaYjmt",
      "uploadDate": "2026-07-19",
      "genre": ["TouchDesigner", "Visual Mapping", "Generative Art"],
    },
    {
      "@type": "Service",
      "name": "Mapping Visual en Vivo",
      "description": "Servicio de mapping visual en vivo con TouchDesigner. Mapping en estructuras predeterminadas con y sin proyector. Live VJ disponible.",
      "provider": { "@id": "https://lllitmts.vercel.app/#artist" },
      "offers": {
        "@type": "Offer",
        "price": "70000",
        "priceCurrency": "ARS",
        "description": "Desde $70.000 ARS (sin proyector)",
      },
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Quién es LLLIT?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "LLLIT es un proyecto de música electrónica y visuales en vivo de Chile. Minimal dub, ambient psicodélico y experimental."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es Inesperado contratiempo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el nuevo álbum de LLLIT (2026) con 5 tracks que exploran minimal dub, ambient psicodélico y experimental. Out Sept 4 en Bandcamp."
          }
        },
        {
          "@type": "Question",
          "name": "¿Ofrece LLLIT servicios de mapping?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, mapping visual en vivo con TouchDesigner, con o sin proyector. Ideal para eventos, fiestas y presentaciones."
          }
        }
      ]
    },
  ],
})} />

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  // Choreografía hero → sección 2 → sección 3 (solo sin reduced-motion)
  mm.add("(prefers-reduced-motion: no-preference)", () => {
    // Handoff del logo: hero (fijo) se encoge, logo LET del header entra
    const tl = gsap.timeline({
      ease: "power2.out",
      scrollTrigger: {
        trigger: "#section1",
        start: "top top",
        end: "bottom top",
        scrub: true,
      },
    });

    tl.from("#hero-key", { duration: 1, scale: 1.25 })
      .to("#hero-key-logo", { opacity: 0 }, "<")
      .to("#logo_header", { opacity: 1 }, "< 0.5")
      .to("#hero-key", { opacity: 0, duration: 0.2 }, 0.4);

    // Entrada escalonada de los videos de la sección 3 (showreel)
    // La sección 2 orquesta su propia coreografía (SectionInfo).
    gsap.from("#section3-videos [data-video-item]", {
      y: 40,
      opacity: 0,
      duration: 0.8,
      stagger: 0.06,
      ease: "power2.out",
      scrollTrigger: {
        trigger: "#section3",
        start: "top 70%",
        toggleActions: "play none none none",
      },
    });
  });

  // Con prefers-reduced-motion: reduce no se oculta nada;
  // todos los markups son visibles por defecto (progressive enhancement).
</script>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import SplitType from "split-type";

  gsap.registerPlugin(ScrollTrigger);

  // FAQ — coreografía propia, scoped a esta sección.
  // Sin prefers-reduced-motion: reduce no se oculta nada (progressive enhancement).
  const faqEl = document.getElementById("faq");
  if (faqEl && window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      // Título: revelado por caracteres, el punto se mantiene en neon.
      const titleSplit = new SplitType("#faq-title", { types: "chars" });
      titleSplit.chars.forEach((char) => {
        if (char.textContent === ".") char.classList.add("text-neon");
      });

      gsap.from(titleSplit.chars, {
        yPercent: 110,
        autoAlpha: 0,
        duration: 0.65,
        stagger: 0.02,
        ease: "power3.out",
        scrollTrigger: {
          trigger: faqEl,
          start: "top 75%",
          toggleActions: "play none none none",
        },
      });

      // Items: entrada escalonada.
      gsap.from(".faq-item", {
        y: 24,
        autoAlpha: 0,
        duration: 0.55,
        stagger: 0.08,
        ease: "power2.out",
        scrollTrigger: {
          trigger: faqEl,
          start: "top 65%",
          toggleActions: "play none none none",
        },
      });

      // CTA.
      gsap.from(".faq-cta", {
        y: 16,
        autoAlpha: 0,
        duration: 0.5,
        ease: "power2.out",
        scrollTrigger: {
          trigger: ".faq-cta",
          start: "top 92%",
          toggleActions: "play none none none",
        },
      });

      return () => titleSplit.revert();
    });
  }
</script>
