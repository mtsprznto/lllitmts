---
import Layout from "@/layouts/Layout.astro"
import HeaderShared from "@/components/HeaderShared.astro"
import Footer from "@/components/Footer.astro"
import { isReleased, RELEASE_DATE, ALBUM_TITLE, PROMO_CODES } from "@/data/promo-codes"

const SITE_URL = "https://lllitmts.vercel.app"
const released = isReleased()
const remaining = PROMO_CODES.length

const formattedDate = RELEASE_DATE.toLocaleDateString("es-ES", {
  day: "numeric", month: "long", year: "numeric",
})
---

<Layout
  title="LLLIT — Canjear código promocional"
  description={`Canjeá tu código promocional para "${ALBUM_TITLE}" de LLLIT. ${!released ? `Disponible desde el ${formattedDate}.` : `${remaining} códigos disponibles.`}`}
  canonicalUrl={`${SITE_URL}/redeem`}
  breadcrumbs={[
    { name: "LLLIT", url: "/" },
    { name: "Canjear código", url: "/redeem" },
  ]}
  hideKeepScrolling
>
  <HeaderShared />

  <!--
    Canje de código · estética Y2K Brutalista / editorial experimental
    (misma dirección que SectionInfo / VideoGrid / CardDetalles):
      - tokens de tema (--surface / --ink / --muted / --line / --color-neon)
      - título gigante fluido clamp + acento "resaltador" neón con contraste
      - badge flotante neón + sombra dura
      - tarjeta formulario chunky (borde 2px + sombra offset #000)
      - labels mono, inputs cuadrados, botón neón con presión Y2K
      - scanline CRT sutil de fondo
    Choreografía GSAP propia (entrada on-load, matchMedia, prefers-reduced-motion).
  -->
  <main class="relative w-full overflow-hidden bg-[var(--surface)] text-[var(--ink)]">
    <!-- Scanlines CRT sutil de fondo — guiño VJ -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      style="background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(255,255,0,0.03) 3px 4px);"
    />

    <div
      class="relative z-10 flex min-h-screen flex-col items-center justify-center px-4 sm:px-8 pt-24 sm:pt-28 pb-16 sm:pb-20"
    >
      <div class="w-full max-w-xl">
        <!-- Eyebrow mono -->
        <p
          id="redeem-eyebrow"
          class="font-mono text-[0.7rem] sm:text-xs font-bold uppercase tracking-[0.35em] text-[var(--muted)] text-center"
        >
          [ BANDCAMP / YUM ]
        </p>

        <!-- Título gigante fluido + acento resaltador neón -->
        <h1
          id="redeem-title"
          class="mt-4 font-bold uppercase leading-[0.85] tracking-tighter text-center"
          style="font-size: clamp(2.4rem, 9vw, 6.5rem);"
        >
          <span class="block">Canjear</span>
          <span class="block"><span class="bg-neon text-black px-1 sm:px-2">código</span></span>
        </h1>

        <!-- Descripción -->
        <p
          id="redeem-desc"
          class="mx-auto mt-6 max-w-lg text-center text-[0.95rem] sm:text-base leading-relaxed text-[var(--muted)]"
        >
          {released
            ? `Ingresá tu correo para recibir un código de verificación y obtener tu código promocional de Bandcamp.`
            : `El canje estará disponible a partir del ${formattedDate}.`
          }
        </p>

        {released ? (
          <div
            id="redeem-app"
            class="relative mt-10 sm:mt-12 border-2 border-[var(--line)] bg-[var(--surface)] p-5 sm:p-8 shadow-[6px_6px_0_#000]"
          >
            <!-- Badge flotante: códigos restantes -->
            <span
              id="redeem-badge"
              class="absolute -top-3 right-3 sm:-right-3 rotate-6 bg-neon text-black border-2 border-[var(--line)] px-3 py-1 font-mono text-[0.65rem] sm:text-xs font-bold uppercase tracking-widest shadow-[4px_4px_0_#000]"
            >
              ● {remaining} CÓDIGOS
            </span>

            <!-- Paso 1 · correo -->
            <div id="step-email" class="space-y-2 sm:space-y-3">
              <label
                for="email-input"
                class="block font-mono text-[0.7rem] sm:text-xs font-bold uppercase tracking-[0.2em] text-[var(--muted)]"
              >
                Tu correo electrónico
              </label>
              <div class="flex gap-2">
                <input
                  id="email-input"
                  type="email"
                  placeholder="tucorreo@ejemplo.com"
                  class="flex-1 min-w-0 rounded-none border-2 border-[var(--line)] bg-transparent px-3 sm:px-4 py-2.5 sm:py-3 text-sm text-[var(--ink)] placeholder:text-[var(--muted)] placeholder:opacity-60 outline-none focus:border-neon transition-colors"
                />
                <button
                  id="btn-send-code"
                  class="shrink-0 rounded-none border-2 border-[var(--line)] bg-neon text-black px-4 sm:px-5 py-2.5 sm:py-3 font-mono text-xs font-bold uppercase tracking-widest shadow-[4px_4px_0_#000] transition-all duration-150 hover:-translate-x-[1px] hover:-translate-y-[1px] hover:shadow-[6px_6px_0_#000] active:translate-x-[1px] active:translate-y-[1px] active:shadow-[2px_2px_0_#000] disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:translate-x-0 disabled:hover:translate-y-0 disabled:hover:shadow-[4px_4px_0_#000]"
                >
                  Enviar
                </button>
              </div>
              <p id="email-error" class="hidden font-mono text-[0.7rem] font-bold uppercase tracking-widest text-red-500"></p>
              <p id="email-success" class="hidden font-mono text-[0.7rem] font-bold uppercase tracking-widest text-emerald-500"></p>
            </div>

            <!-- Paso 2 · código de verificación -->
            <div id="step-code" class="space-y-2 sm:space-y-3 hidden">
              <label
                for="code-input"
                class="block font-mono text-[0.7rem] sm:text-xs font-bold uppercase tracking-[0.2em] text-[var(--muted)]"
              >
                Código de verificación (4 dígitos)
              </label>
              <div class="flex gap-2">
                <input
                  id="code-input"
                  type="text"
                  inputmode="numeric"
                  maxlength="4"
                  placeholder="1234"
                  class="flex-1 min-w-0 rounded-none border-2 border-[var(--line)] bg-transparent px-3 sm:px-4 py-2.5 sm:py-3 font-mono text-center text-lg sm:text-xl tracking-[0.5em] text-[var(--ink)] placeholder:text-[var(--muted)] placeholder:opacity-60 outline-none focus:border-neon transition-colors"
                />
                <button
                  id="btn-verify"
                  class="shrink-0 rounded-none border-2 border-[var(--line)] bg-neon text-black px-4 sm:px-5 py-2.5 sm:py-3 font-mono text-xs font-bold uppercase tracking-widest shadow-[4px_4px_0_#000] transition-all duration-150 hover:-translate-x-[1px] hover:-translate-y-[1px] hover:shadow-[6px_6px_0_#000] active:translate-x-[1px] active:translate-y-[1px] active:shadow-[2px_2px_0_#000] disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:translate-x-0 disabled:hover:translate-y-0 disabled:hover:shadow-[4px_4px_0_#000]"
                >
                  Verificar
                </button>
              </div>
              <p id="code-error" class="hidden font-mono text-[0.7rem] font-bold uppercase tracking-widest text-red-500"></p>
            </div>

            <!-- Paso 3 · código promocional -->
            <div id="step-success" class="hidden text-center space-y-4 sm:space-y-5 py-2 sm:py-3">
              <div
                class="inline-flex h-12 w-12 sm:h-14 sm:w-14 items-center justify-center border-2 border-[var(--line)] bg-neon text-black text-xl sm:text-2xl shadow-[4px_4px_0_#000]"
              >
                ✓
              </div>
              <p
                class="font-mono text-[0.7rem] sm:text-xs font-bold uppercase tracking-[0.2em] text-[var(--muted)]"
              >
                Tu código promocional de Bandcamp:
              </p>
              <div class="border-2 border-[var(--line)] bg-neon text-black px-4 sm:px-6 py-4 sm:py-5 shadow-[6px_6px_0_#000]">
                <p
                  id="promo-code-display"
                  class="font-mono text-2xl sm:text-3xl font-bold tracking-[0.15em] select-all break-all"
                ></p>
              </div>
              <p class="text-[0.75rem] sm:text-sm text-[var(--muted)] leading-relaxed">
                Canjealo en{" "}
                <a
                  href="https://lllit3.bandcamp.com/yum"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline decoration-2 underline-offset-4 hover:text-neon transition-colors"
                >
                  lllit3.bandcamp.com/yum
                </a>
              </p>
            </div>
          </div>
        ) : (
          <div
            id="redeem-wait"
            class="mt-10 sm:mt-12 mx-auto max-w-md border-2 border-[var(--line)] bg-[var(--surface)] px-6 py-8 text-center shadow-[6px_6px_0_#000]"
          >
            <div
              class="inline-flex h-12 w-12 sm:h-14 sm:w-14 items-center justify-center border-2 border-[var(--line)] bg-neon text-black text-lg sm:text-xl shadow-[4px_4px_0_#000]"
            >
              ⏎
            </div>
            <p class="mt-4 font-mono text-[0.7rem] sm:text-xs font-bold uppercase tracking-[0.2em] text-[var(--muted)]">
              Disponible desde
            </p>
            <p class="mt-2 font-mono text-lg sm:text-xl font-bold tracking-[0.15em] text-[var(--ink)]">
              {formattedDate}
            </p>
            <a
              href="/"
              class="mt-6 inline-flex items-center gap-1.5 font-mono text-[0.7rem] sm:text-xs font-bold uppercase tracking-[0.2em] text-[var(--muted)] hover:text-neon transition-colors"
            >
              <span>&larr;</span>
              Volver a LLLIT
            </a>
          </div>
        )}
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import SplitType from "split-type";

  const titleEl = document.getElementById("redeem-title");
  const app = document.getElementById("redeem-app") || document.getElementById("redeem-wait");
  const badge = document.getElementById("redeem-badge");

  const mm = gsap.matchMedia();
  mm.add("(prefers-reduced-motion: no-preference)", () => {
    if (titleEl) {
      const title = new SplitType(titleEl, { types: "words,chars" });
      // Acento "resaltador" sobre "código" (SplitType re-crea los spans sin clases):
      // texto negro sobre neón mantiene contraste incluso en tema claro.
      title.words
        .filter((w) => /código|codigo/i.test(w.textContent || ""))
        .forEach((w) => {
          w.style.backgroundColor = "var(--color-neon)";
          w.style.color = "#000";
          w.style.padding = "0 0.2em";
        });

      gsap.from(title.chars, {
        yPercent: 110,
        opacity: 0,
        duration: 0.7,
        stagger: 0.03,
        ease: "power3.out",
      });
    }

    gsap.from("#redeem-eyebrow", {
      y: -16,
      opacity: 0,
      duration: 0.5,
      ease: "power2.out",
      delay: 0.1,
    });

    gsap.from("#redeem-desc", {
      y: 20,
      opacity: 0,
      duration: 0.6,
      ease: "power2.out",
      delay: 0.3,
    });

    if (app) {
      gsap.from(app, {
        y: 40,
        opacity: 0,
        duration: 0.7,
        ease: "power2.out",
        delay: 0.4,
      });
    }

    if (badge) {
      gsap.from(badge, {
        y: -20,
        opacity: 0,
        rotation: 10,
        duration: 0.6,
        ease: "back.out(2.5)",
        delay: 0.55,
      });
    }
  });

  mm.add("(prefers-reduced-motion: reduce)", () => {
    gsap.set(
      "#redeem-title, #redeem-eyebrow, #redeem-desc, #redeem-app, #redeem-wait, #redeem-badge",
      { opacity: 1 }
    );
  });
</script>

<script>
  const emailInput = document.getElementById("email-input") as HTMLInputElement | null
  const codeInput = document.getElementById("code-input") as HTMLInputElement | null
  const btnSend = document.getElementById("btn-send-code") as HTMLButtonElement | null
  const btnVerify = document.getElementById("btn-verify") as HTMLButtonElement | null
  const emailError = document.getElementById("email-error") as HTMLElement | null
  const emailSuccess = document.getElementById("email-success") as HTMLElement | null
  const codeError = document.getElementById("code-error") as HTMLElement | null
  const stepEmail = document.getElementById("step-email") as HTMLElement | null
  const stepCode = document.getElementById("step-code") as HTMLElement | null
  const stepSuccess = document.getElementById("step-success") as HTMLElement | null
  const promoDisplay = document.getElementById("promo-code-display") as HTMLElement | null

  let currentEmail = ""

  function show(el: HTMLElement | null) { el?.classList.remove("hidden") }
  function hide(el: HTMLElement | null) { el?.classList.add("hidden") }
  function setError(el: HTMLElement | null, msg: string) {
    if (el) { el.textContent = msg; el.classList.remove("hidden") }
  }
  function setSuccess(el: HTMLElement | null, msg: string) {
    if (el) { el.textContent = msg; el.classList.remove("hidden") }
  }

  btnSend?.addEventListener("click", async () => {
    const email = emailInput?.value.trim()
    if (!email || !email.includes("@")) {
      setError(emailError, "Ingresá un email válido.")
      return
    }
    hide(emailError)
    hide(emailSuccess)
    btnSend.disabled = true
    btnSend.textContent = "Enviando…"

    try {
      const res = await fetch("/api/redeem/request-code", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      })
      const data = await res.json()
      if (data.success) {
        currentEmail = email
        hide(stepEmail)
        show(stepCode)
        codeInput?.focus()
      } else {
        setError(emailError, data.error || "Error al enviar el código.")
      }
    } catch {
      setError(emailError, "Error de conexión. Intentalo de nuevo.")
    } finally {
      btnSend.disabled = false
      btnSend.textContent = "Enviar"
    }
  })

  btnVerify?.addEventListener("click", async () => {
    const code = codeInput?.value.trim()
    if (!code || code.length !== 4 || !/^\d{4}$/.test(code)) {
      setError(codeError, "Ingresá el código de 4 dígitos.")
      return
    }
    hide(codeError)
    btnVerify.disabled = true
    btnVerify.textContent = "Verificando…"

    try {
      const res = await fetch("/api/redeem/verify", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: currentEmail, verificationCode: code }),
      })
      const data = await res.json()
      if (data.success && data.promoCode) {
        hide(stepCode)
        show(stepSuccess)
        if (promoDisplay) promoDisplay.textContent = data.promoCode
      } else {
        setError(codeError, data.error || "Código incorrecto.")
      }
    } catch {
      setError(codeError, "Error de conexión. Intentalo de nuevo.")
    } finally {
      btnVerify.disabled = false
      btnVerify.textContent = "Verificar"
    }
  })

  codeInput?.addEventListener("input", () => {
    if (codeInput.value.length > 4) codeInput.value = codeInput.value.slice(0, 4)
    codeInput.value = codeInput.value.replace(/\D/g, "")
  })
</script>
