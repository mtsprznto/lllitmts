---
import Layout from "@/layouts/Layout.astro"
import HeaderShared from "@/components/HeaderShared.astro"
import Footer from "@/components/Footer.astro"
import AudioPreview from "@/components/AudioPreview.astro"
import FocusTracksSection from "@/components/album/FocusTracksSection.astro"
import PressSection from "@/components/album/PressSection.astro"
import LinkhubSection from "@/components/album/LinkhubSection.astro"
import BandcampEmbed from "@/components/album/BandcampEmbed.astro"
import { getAlbumBySlug, type Album } from "@/data/albums"

const { slug } = Astro.params
const album: Album | undefined = getAlbumBySlug(slug || "")

if (!album) {
  return Astro.redirect("/404", 302)
}

const SITE_URL = "https://lllitmts.vercel.app"
const getWebpUrl = (url: string) => url.replace(/\.png$/, ".webp").replace(/\.jpg$/, ".webp")
const getAvifUrl = (url: string) => url.replace(/\.png$/, ".avif").replace(/\.jpg$/, ".avif")
const FULL_COVER_URL = `${SITE_URL}${album.coverUrl}`
const trackCount = album.tracks.length

// PRD-001 §4: countdown vencido → estado "Out now" server-rendered (idempotente en cliente)
const releaseTs = Date.parse(`${album.releaseDate}T00:00:00Z`)
const isReleased = Number.isFinite(releaseTs) && Date.now() >= releaseTs

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MusicGroup",
      "@id": `${SITE_URL}/#artist`,
      "name": "LLLIT",
      "url": SITE_URL,
      "sameAs": [
        album.bandcampUrl,
        album.instagramUrl,
        album.youtubeUrl,
        album.soundcloudUrl,
      ]
    },
    {
      "@type": "MusicAlbum",
      "@id": `${SITE_URL}/album/${album.slug}#album`,
      "name": album.title,
      "byArtist": { "@id": `${SITE_URL}/#artist` },
      "datePublished": album.releaseDate,
      "numTracks": trackCount,
      "genre": album.genres,
      "image": FULL_COVER_URL,
      "albumReleaseType": "https://schema.org/AlbumRelease",
      "track": album.tracks.map((t, i) => ({
        "@type": "MusicRecording",
        "position": i + 1,
        "name": t.name,
      })),
      "offers": {
        "@type": "Offer",
        "url": album.bandcampUrl,
        "price": album.price.replace("$", "").replace(" USD", ""),
        "priceCurrency": "USD",
        "availability": "https://schema.org/PreOrder",
      }
    }
  ]
}
---

<Layout
  hideKeepScrolling
  title={`LLLIT — ${album.title} (${album.genres.join(", ")}) 2026`}
  description={album.descriptionEn}
  ogTitle={`LLLIT — ${album.title}`}
  ogDescription={album.descriptionEn}
  ogImage={FULL_COVER_URL}
  structuredData={structuredData}
  canonicalUrl={`${SITE_URL}/album/${album.slug}`}
  breadcrumbs={[
    { name: "LLLIT", url: "/" },
    { name: album.title, url: `/album/${album.slug}` },
  ]}
>
  <HeaderShared />

  <main
    id="album-page"
    class="album-page relative min-h-screen overflow-hidden bg-[#0a0a0a] text-white"
  >
    <!-- Fondo: visual con parallax -->
    <div class="absolute inset-0" aria-hidden="true">
      <img
        data-bg-visual
        src={album.visualBgUrl}
        alt=""
        class="h-full w-full scale-[1.08] object-cover opacity-[0.07]"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a] via-[#0a0a0a]/70 to-[#0a0a0a]"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#0a0a0a]/50 via-transparent to-[#0a0a0a]/50"></div>
    </div>

    <!-- Capa ASCII decorativa (desktop) -->
    <pre
      data-ascii
      aria-hidden="true"
      class="pointer-events-none absolute bottom-0 right-0 hidden select-none font-mono text-[10px] leading-[1.15] text-white opacity-[0.05] lg:block"
>▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
▓ LLLIT ▓ IC/26 ▓ INESPERADO CONTRATIEMPO ▓ OCT 02 ▓
▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒
██ 10110110 ██ 01001101 ██ 01101001 ██ 01101110 ██ ██
██ 01001001 ██ 01000011 ██ 00101111 ██ 00110110 ██ ██
██████████████████████████████████████████████████████</pre>

    <!-- Sticker amarillo (desktop, flotante) -->
    <div
      data-sticker
      aria-hidden="true"
      class="absolute right-6 top-24 z-20 hidden -rotate-6 select-none border-2 border-black bg-[#fde047] px-4 py-2 text-center shadow-[4px_4px_0_rgba(0,0,0,0.6)] lg:block"
    >
      <p class="font-mono text-[10px] font-bold uppercase leading-tight tracking-[0.18em] text-black">
        {album.releaseType}
      </p>
      <p class="font-mono text-[8px] uppercase leading-tight tracking-[0.25em] text-black/60">
        NYP {album.price}
      </p>
    </div>

    <div class="relative z-10 mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
      <!-- Topbar -->
      <div class="mb-14 flex items-center justify-between border-b border-white/10 pb-3">
        <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-white/40">
          [ LLLIT — {album.label} ]
        </span>
        <span class="hidden font-mono text-[10px] uppercase tracking-[0.25em] text-white/25 sm:block">
          Release // {album.campaignDate}
        </span>
      </div>

      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <!-- Portada -->
        <div class="lg:col-span-5">
          <div class="relative" data-cover-wrap>
            <div class="absolute -left-3 -top-3 hidden h-6 w-6 items-center justify-center font-mono text-sm text-white/40 sm:flex" aria-hidden="true">+</div>
            <div class="absolute -right-3 -top-3 hidden h-6 w-6 items-center justify-center font-mono text-sm text-white/40 sm:flex" aria-hidden="true">+</div>
            <div class="absolute -bottom-3 -left-3 hidden h-6 w-6 items-center justify-center font-mono text-sm text-white/40 sm:flex" aria-hidden="true">+</div>
            <div class="absolute -bottom-3 -right-3 hidden h-6 w-6 items-center justify-center font-mono text-sm text-white/40 sm:flex" aria-hidden="true">+</div>

            <div class="relative border-2 border-white/15 bg-[#111] p-2" data-cover-frame>
              <div class="relative overflow-hidden" style="aspect-ratio: 1 / 1">
                <picture>
                  <source srcset={getWebpUrl(album.coverUrl)} type="image/webp" />
                  <img
                    src={album.coverUrl}
                    alt={`${album.title} — Álbum de ${album.artist} por Camila Bravo`}
                    class="h-full w-full object-cover"
                    fetchpriority="high"
                    decoding="async"
                  />
                </picture>
                <!-- Scanline sutil sobre la tapa -->
                <div
                  class="pointer-events-none absolute inset-0 bg-[repeating-linear-gradient(0deg,rgba(0,0,0,0.22)_0px,rgba(0,0,0,0.22)_1px,transparent_1px,transparent_3px)]"
                  aria-hidden="true"
                ></div>
              </div>
              <div class="flex items-center justify-between px-1 pt-2 font-mono text-[9px] uppercase tracking-[0.2em] text-white/30">
                <span>LLLIT — IC/26</span>
                <span>Side A</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Contenido -->
        <div class="lg:col-span-7">
          <p data-anim class="mb-4 font-mono text-[11px] uppercase tracking-[0.25em] text-amber-300/90">
            /// {album.genres.join(" · ").toLowerCase()}
          </p>

          <h1
            id="album-title"
            class="text-2xl font-bold uppercase leading-[0.9] tracking-tighter sm:text-5xl lg:text-7xl xl:text-8xl"
          >
            Inesperado<br />contratiempo
          </h1>

          <p data-anim class="mt-6 max-w-xl text-sm leading-relaxed text-white/50">
            {album.description}
          </p>

          <!-- Badges -->
          <div data-anim class="mt-7 flex flex-wrap gap-2">
            <span class="border border-white/15 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-white/55">[ {album.releaseType} ]</span>
            <span class="border border-amber-300/30 bg-amber-300/5 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-amber-200/90">[ {album.campaignDate} ]</span>
            <span class="border border-white/15 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-white/55">[ NYP {album.price} ]</span>
            <span class="border border-white/15 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-white/55">[ {trackCount} Tracks ]</span>
          </div>

          <!-- Countdown (PRD-001 §4: si ya salió, estado "Out now" server-rendered) -->
          <div
            data-countdown
            data-countdown-target={releaseTs}
            data-bandcamp={album.bandcampUrl}
            class="mt-8 flex items-center justify-between border border-white/10 bg-white/[0.02] px-4 py-3"
          >
            <span data-countdown-label class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/40">
              {isReleased ? "Out now" : "Out in"}
            </span>
            <span data-countdown-value class="font-mono text-sm tabular-nums text-amber-200/90">
              {
                isReleased ? (
                  <a
                    href={album.bandcampUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline underline-offset-4 transition-colors hover:text-white"
                  >
                    stream / buy
                  </a>
                ) : (
                  "--d --h --m --s"
                )
              }
            </span>
          </div>

          <!-- Tracklist -->
          <div class="mt-10">
            <h2 class="mb-2 flex justify-between border-b border-white/10 pb-2 font-mono text-[10px] uppercase tracking-[0.25em] text-white/40">
              <span>Tracklist</span>
              <span class="text-white/25">BPM</span>
            </h2>
            <div data-tracklist>
              {
                album.tracks.map((t) => (
                  <div
                    data-track
                    class="group grid grid-cols-[2.5rem_1fr_auto] items-center gap-3 border-b border-white/[0.06] py-2.5"
                  >
                    {t.previewUrl ? (
                      <AudioPreview src={t.previewUrl} trackName={t.name} />
                    ) : (
                      <span class="w-7 shrink-0 text-center font-mono text-[11px] text-white/30">{t.num}</span>
                    )}
                    <div class="min-w-0">
                      <p class="truncate text-sm text-white/80 transition-colors group-hover:text-amber-200">
                        {t.name}
                      </p>
                      <div class="mt-1.5 h-[3px] w-20 overflow-hidden bg-white/10 sm:w-24">
                        <div
                          data-bar
                          data-pct={t.pct}
                          class="h-full bg-white/40 transition-colors group-hover:bg-amber-300"
                          style={`width: ${t.pct}%`}
                        ></div>
                      </div>
                    </div>
                    <span class="font-mono text-[11px] tabular-nums text-white/40">{t.bpm}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Reproductor incrustado (PRD_002) -->
          <BandcampEmbed album={album} />

          <!-- Créditos -->
          <div data-credits class="mt-10 grid grid-cols-1 gap-px border border-white/10 bg-white/10 sm:grid-cols-2">
            {
              album.credits.map((c) => (
                <div class="bg-[#0a0a0a] px-4 py-3">
                  <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-white/30">{c.role}</p>
                  <p class="mt-0.5 text-xs font-medium text-white/70">{c.name}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Bloques editoriales PRD-001 (A/B/C) -->
      <FocusTracksSection album={album} />
      <PressSection album={album} />
      <LinkhubSection album={album} />

      <!-- Volver -->
      <div class="mt-24 text-center">
        <a
          href="/"
          data-anim
          class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.2em] text-white/30 transition-colors hover:text-white/60"
        >
          <span aria-hidden="true">&larr;</span>
          Volver a LLLIT
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>



<script>
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"
  import { SplitText } from "gsap/SplitText"

  gsap.registerPlugin(ScrollTrigger, SplitText)

  const page = document.getElementById("album-page")
  if (page) {
    gsap.context(() => {
      // PRD-001 §4: estado "Out now" idempotente (server-rendered o al vencer el countdown)
      const markReleased = () => {
        const label = page.querySelector("[data-countdown-label]")
        const val = page.querySelector("[data-countdown-value]")
        const bc = page.querySelector("[data-countdown]")?.getAttribute("data-bandcamp")
        if (label) label.textContent = "Out now"
        if (val && bc) {
          val.innerHTML = `<a href="${bc}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 transition-colors hover:text-white">stream / buy</a>`
        }
      }

      const mm = gsap.matchMedia()

      // ── Usuario con prefers-reduced-motion: todo estático ──
      mm.add("(prefers-reduced-motion: reduce)", () => {
        const attr = page.querySelector("[data-countdown]")?.getAttribute("data-countdown-target")
        const target = attr ? Number(attr) : NaN
        if (Number.isFinite(target) && Date.now() >= target) {
          markReleased()
        } else {
          const countEl = page.querySelector("[data-countdown-value]")
          if (countEl) countEl.textContent = "02 · 10 · 2026"
        }
        return () => {}
      })

      // ── Motion completo (solo si el usuario no pidió reducirlo) ──
      mm.add("(prefers-reduced-motion: no-preference)", () => {
        const isDesktop = window.matchMedia("(min-width: 1024px)").matches

        // Parallax del fondo
        gsap.fromTo(
          "[data-bg-visual]",
          { yPercent: -8 },
          {
            yPercent: 8,
            ease: "none",
            scrollTrigger: {
              trigger: page,
              start: "top bottom",
              end: "bottom top",
              scrub: true,
            },
          }
        )

        // Rotación sutil de la portada al scrollear
        gsap.to("[data-cover-frame]", {
          rotation: 2.5,
          ease: "none",
          scrollTrigger: {
            trigger: page,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
          },
        })

        // Revelado de la portada (clip + entrada lateral)
        gsap.from("[data-cover-frame]", {
          clipPath: "inset(0 100% 0 0)",
          xPercent: -4,
          duration: 1.1,
          ease: "power3.out",
          scrollTrigger: { trigger: page, start: "top 72%" },
        })

        // Coreografía del contenido
        const tl = gsap.timeline({
          scrollTrigger: { trigger: page, start: "top 72%" },
        })

        tl.from("#album-title", {
            y: 40,
            autoAlpha: 0,
            duration: 0.8,
            ease: "power3.out",
          })
          .from(
            "[data-anim]",
            {
              y: 26,
              autoAlpha: 0,
              duration: 0.6,
              stagger: 0.1,
              ease: "power3.out",
            },
            0.35
          )
          .from(
            "[data-countdown]",
            {
              y: 20,
              autoAlpha: 0,
              duration: 0.5,
              ease: "power2.out",
            },
            0.7
          )
          .from(
            "[data-track]",
            {
              y: 14,
              autoAlpha: 0,
              duration: 0.4,
              stagger: 0.06,
              ease: "power2.out",
            },
            0.8
          )
          .from(
            "[data-bar]",
            {
              scaleX: 0,
              transformOrigin: "left center",
              duration: 0.5,
              stagger: 0.05,
              ease: "power2.out",
            },
            1.1
          )
          .from(
            "[data-credits] > *",
            {
              y: 12,
              autoAlpha: 0,
              duration: 0.35,
              stagger: 0.05,
              ease: "power2.out",
            },
            1.3
          )
          .from(
            "[data-sticker]",
            {
              scale: 0,
              rotation: -30,
              autoAlpha: 0,
              duration: 0.5,
              ease: "back.out(2)",
            },
            1.5
          )

        // Flotación del sticker (solo desktop)
        if (isDesktop) {
          gsap.to("[data-sticker]", {
            y: 12,
            rotation: 4,
            duration: 2.6,
            yoyo: true,
            repeat: -1,
            ease: "sine.inOut",
            delay: 2,
          })
        }

        // Hover de tracks: la barra se expande hasta 100% y vuelve
        page.querySelectorAll("[data-track]").forEach((row) => {
          const bar = row.querySelector("[data-bar]")
          if (!bar) return
          const pct = parseFloat(bar.dataset.pct || "50") || 50
          row.addEventListener("mouseenter", () => {
            gsap.to(bar, {
              scaleX: 100 / pct,
              transformOrigin: "left center",
              duration: 0.35,
              ease: "power2.out",
            })
          })
          row.addEventListener("mouseleave", () => {
            gsap.to(bar, {
              scaleX: 1,
              transformOrigin: "left center",
              duration: 0.35,
              ease: "power2.out",
            })
          })
        })

        // ── Bloques editoriales PRD-001 (focus / press / linkhub) ──
        if (page.querySelector("[data-focus-section]")) {
          gsap.from("[data-focus-header]", {
            y: 24,
            autoAlpha: 0,
            duration: 0.6,
            ease: "power3.out",
          })
          gsap.from("[data-focus-item]", {
            y: 16,
            autoAlpha: 0,
            stagger: 0.08,
            duration: 0.45,
            ease: "power2.out",
          })
        }
        if (page.querySelector("[data-press-section]")) {
          gsap.from("[data-press-header]", {
            y: 24,
            autoAlpha: 0,
            duration: 0.6,
            ease: "power3.out",
          })
          gsap.from("[data-press-item]", {
            y: 16,
            autoAlpha: 0,
            stagger: 0.08,
            duration: 0.45,
            ease: "power2.out",
          })
        }
        if (page.querySelector("[data-linkhub]")) {
          gsap.from("[data-linkhub-header]", {
            y: 24,
            autoAlpha: 0,
            duration: 0.6,
            ease: "power3.out",
          })
          gsap.from("[data-linkhub-item]", {
            y: 16,
            autoAlpha: 0,
            scale: 0.96,
            stagger: 0.06,
            duration: 0.45,
            ease: "power2.out",
          })
        }

        // Countdown a la fecha de lanzamiento (data-countdown-target, server-rendered si ya venció)
        const box = page.querySelector("[data-countdown]")
        const targetAttr = box ? box.getAttribute("data-countdown-target") : null
        const target = targetAttr ? Number(targetAttr) : NaN
        const countEl = page.querySelector("[data-countdown-value]")
        const pad = (n: number) => String(n).padStart(2, "0")
        const tick = () => {
          if (!countEl) return
          const diff = target - Date.now()
          if (diff <= 0) {
            markReleased()
            gsap.ticker.remove(tick)
            return
          }
          const d = Math.floor(diff / 86400000)
          const h = Math.floor(diff / 3600000) % 24
          const m = Math.floor(diff / 60000) % 60
          const s = Math.floor(diff / 1000) % 60
          countEl.textContent = `${pad(d)}d ${pad(h)}h ${pad(m)}m ${pad(s)}s`
        }
        if (!Number.isFinite(target)) {
          // atributo ausente/inválido: nada que contar
        } else if (Date.now() >= target) {
          markReleased()
        } else {
          tick()
          gsap.ticker.add(tick)
        }

        return () => {
          gsap.ticker.remove(tick)
        }
      })
    }, page)
  }
</script>
