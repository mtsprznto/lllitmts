---
import Layout from "@/layouts/Layout.astro";
import HeaderShared from "@/components/HeaderShared.astro";
import Footer from "@/components/Footer.astro";
import GalleryTech from "@/components/gallery/GalleryTech.astro";
import { gallery } from "@/data/gallery";

const SITE_URL = "https://lllitmts.vercel.app";

// Absolutiza solo rutas locales (/…); las URL remotas ya son absolutas.
const abs = (u: string) => (u.startsWith("/") ? `${SITE_URL}${u}` : u);

// JSON‑LD estructurado: CollectionPage + ImageGallery / VideoObject
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${SITE_URL}/gallery#collection`,
      "name": "Galería de Arte LLLIT",
      "description": "Obras visuales y videos de LLLIT bajo el design system Technopunk Enterprise.",
      "url": `${SITE_URL}/gallery`,
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": gallery.map((item, i) => {
          const base = {
            "@type": item.kind === "image" ? "ImageObject" : "VideoObject",
            "name": item.title,
            "description": item.alt,
            "url": abs(item.src),
          };
          if (item.kind === "image") {
            return {
              "@type": "ListItem",
              "position": i + 1,
              "item": { ...base, "thumbnailUrl": abs(item.srcWebp ?? item.src) },
            };
          }
          return {
            "@type": "ListItem",
            "position": i + 1,
            "item": {
              ...base,
              "thumbnailUrl": abs(item.poster ?? item.srcWebp ?? item.src),
              "duration": "PT1M",
              "uploadDate": "2026",
            },
          };
        }),
      },
    },
  ],
};
---

<Layout
  title="LLLIT — Galería de Arte (Technopunk Enterprise)"
  description="Explorá la galería de obras visuales y videos de LLLIT bajo un design system oscuro y terminal.",
  ogTitle="LLLIT — Galería"
  ogDescription="Obras visuales y videos de LLLIT — Technopunk Enterprise."
  canonicalUrl={`${SITE_URL}/gallery`}
  breadcrumbs={[{ name: "LLLIT", url: "/" }, { name: "Galería", url: "/gallery" }]}
  structuredData={structuredData}
>
  <HeaderShared />

  <main id="gallery-index" class="gallery-index relative min-h-screen overflow-hidden bg-[#090c10] text-[#f0f6fc]">
    <GalleryTech items={gallery} />
  </main>

  <Footer />
</Layout>
