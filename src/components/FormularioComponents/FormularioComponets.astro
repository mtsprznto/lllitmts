<main
  id="formulario-index"
  class="formulario-index relative min-h-screen overflow-hidden bg-[#0a0a0a] text-white"
>
  <!-- Capa ASCII decorativa (desktop, con parallax sutil) -->
  <pre
    data-ascii
    aria-hidden="true"
    class="pointer-events-none absolute bottom-0 right-0 hidden select-none font-mono text-[10px] leading-[1.15] text-white opacity-[0.05] lg:block"
>▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
▓ LLLIT ▓ TRANSMISIÓN ▓ BOOKING ▓ IC/26 ▓ SEÑAL ▓
▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒
██ 01001100 ██ 01001100 ██ 01001001 ██ 01010100 ██ ██
██ 01000010 ██ 01001111 ██ 01001111 ██ 01001011 ██ ██
████████████████████████████████████████████████████████</pre>

  <!-- Sticker amarillo (desktop, flotante) -->
  <div
    data-sticker
    aria-hidden="true"
    class="absolute right-6 top-24 z-20 hidden -rotate-6 select-none border-2 border-black bg-[#fde047] px-4 py-2 text-center shadow-[4px_4px_0_rgba(0,0,0,0.6)] lg:block"
  >
    <p class="font-mono text-[10px] font-bold uppercase leading-tight tracking-[0.18em] text-black">
      Booking
    </p>
    <p class="font-mono text-[8px] uppercase leading-tight tracking-[0.25em] text-black/60">
      Señal abierta 2026
    </p>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:py-28">
    <!-- Topbar -->
    <div class="mb-16 flex items-center justify-between border-b border-white/10 pb-3">
      <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-white/40">
        [ LLLIT — Transmisión ]
      </span>
      <span class="hidden font-mono text-[10px] uppercase tracking-[0.25em] text-white/25 sm:block">
        Booking // 2026
      </span>
    </div>

    <!-- Header editorial -->
    <header class="mb-14 max-w-2xl md:mb-16">
      <p data-anim class="mb-4 font-mono text-[11px] uppercase tracking-[0.25em] text-amber-300/90">
        /// canal de transmisión
      </p>
      <h1
        id="formulario-index-title"
        class="text-5xl font-bold uppercase leading-[0.9] tracking-tighter sm:text-6xl md:text-7xl lg:text-8xl"
      >
        Contacto
      </h1>
      <p data-anim class="mt-6 max-w-xl text-sm leading-relaxed text-white/50">
        Booking de mapping visual en vivo, VJ, música, eventos y colaboraciones.
        Contanos tu proyecto — respondemos dentro de 24–48&nbsp;h.
      </p>

      <!-- Badges -->
      <div data-anim class="mt-7 flex flex-wrap gap-2">
        <span class="border border-white/15 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-white/55">[ Booking ]</span>
        <span class="border border-white/15 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-white/55">[ Mapping ]</span>
        <span class="border border-white/15 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-white/55">[ VJ ]</span>
        <span class="border border-white/15 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-white/55">[ Música ]</span>
        <span class="border border-amber-300/30 bg-amber-300/5 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-amber-200/90">[ 2026 ]</span>
      </div>
    </header>

    <!-- Panel de transmisión -->
    <section class="relative max-w-2xl border border-white/15 p-6 sm:p-8">
      <!-- Marcas de esquina -->
      <span class="absolute -left-3 -top-3 hidden h-5 w-5 items-center justify-center font-mono text-[11px] text-white/40 sm:flex" aria-hidden="true">+</span>
      <span class="absolute -right-3 -top-3 hidden h-5 w-5 items-center justify-center font-mono text-[11px] text-white/40 sm:flex" aria-hidden="true">+</span>
      <span class="absolute -bottom-3 -left-3 hidden h-5 w-5 items-center justify-center font-mono text-[11px] text-white/40 sm:flex" aria-hidden="true">+</span>
      <span class="absolute -bottom-3 -right-3 hidden h-5 w-5 items-center justify-center font-mono text-[11px] text-white/40 sm:flex" aria-hidden="true">+</span>

      <!-- Cabecera del panel -->
      <div class="mb-8 flex items-center justify-between border-b border-white/10 pb-3">
        <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-white/40">
          [ TRANSMISIÓN_01 ]
        </span>
        <span class="hidden font-mono text-[10px] uppercase tracking-[0.25em] text-white/25 sm:block">
          [ Formulario ]
        </span>
      </div>

      <form
        id="contact-form"
        method="POST"
        action="/api/contact"
        class="space-y-7"
      >
        <div data-field class="space-y-2">
          <label for="name" class="block font-mono text-[10px] uppercase tracking-[0.25em] text-white/40">
            [ Nombre ]
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            minlength="2"
            placeholder="tu nombre"
            autocomplete="name"
            class="form-input"
          />
        </div>

        <div data-field class="space-y-2">
          <label for="email" class="block font-mono text-[10px] uppercase tracking-[0.25em] text-white/40">
            [ Correo ]
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="tu@correo.cl"
            autocomplete="email"
            class="form-input"
          />
        </div>

        <div data-field class="space-y-2">
          <label for="message" class="block font-mono text-[10px] uppercase tracking-[0.25em] text-white/40">
            [ Mensaje ]
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            minlength="5"
            placeholder="contanos sobre tu evento, espacio o colaboración..."
            class="form-input resize-none"
          ></textarea>
        </div>

        <div data-field class="pt-2">
          <button
            id="form-submit"
            type="submit"
            class="w-full cursor-pointer bg-[#fde047] px-6 py-4 font-mono text-xs font-bold uppercase tracking-[0.25em] text-black shadow-[6px_6px_0_rgba(0,0,0,0.6)] transition-all hover:-translate-y-0.5 hover:shadow-[8px_8px_0_rgba(0,0,0,0.6)] active:translate-y-0 active:shadow-[6px_6px_0_rgba(0,0,0,0.6)] disabled:cursor-not-allowed disabled:opacity-60"
          >
            [ Transmitir mensaje → ]
          </button>
          <p
            id="form-status"
            class="form-status"
            aria-live="polite"
            role="status"
          ></p>
        </div>
      </form>
    </section>

    <!-- Canales alternativos -->
    <div data-anim class="mt-10 flex max-w-2xl flex-wrap gap-x-6 gap-y-2 font-mono text-[10px] uppercase tracking-[0.2em]">
      <a href="mailto:lllit@mtsprz.org" class="text-white/30 transition-colors hover:text-amber-200/80">[ Email: lllit@mtsprz.org ]</a>
      <a href="https://instagram.com/lllit_3" target="_blank" rel="noopener noreferrer" class="text-white/30 transition-colors hover:text-amber-200/80">[ IG: @lllit_3 ]</a>
      <a href="https://lllit3.bandcamp.com" target="_blank" rel="noopener noreferrer" class="text-white/30 transition-colors hover:text-amber-200/80">[ Bandcamp ]</a>
    </div>

    <!-- Volver -->
    <div class="mt-24 text-center">
      <a
        href="/"
        data-anim
        class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.2em] text-white/30 transition-colors hover:text-white/60"
      >
        <span aria-hidden="true">&larr;</span>
        Volver a LLLIT
      </a>
    </div>
  </div>
</main>

<style>
  /* ── Inputs del formulario (estilo brutalista) ─────────────── */
  .form-input {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.02);
    padding: 0.8rem 1rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.875rem;
    color: #fff;
    border-radius: 0;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .form-input::placeholder {
    color: rgba(255, 255, 255, 0.2);
  }
  .form-input:hover {
    border-color: rgba(255, 255, 255, 0.3);
  }
  .form-input:focus {
    border-color: rgba(253, 224, 71, 0.9);
    background: rgba(253, 224, 71, 0.03);
    box-shadow: 3px 3px 0 rgba(253, 224, 71, 0.15);
  }
</style>

<style is:global>
  /* Spans inyectados por SplitText en runtime → globales,
     pero namespaced bajo .formulario-index para no filtrar. */
  .formulario-index .split-line {
    display: block;
    overflow: hidden;
  }
  .formulario-index .split-char {
    display: inline-block;
    will-change: transform;
  }

  /* Estado del envío (clases mutadas desde JS en runtime) */
  .formulario-index .form-status {
    margin-top: 1rem;
    min-height: 1.25rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .formulario-index .form-status.loading {
    color: rgba(255, 255, 255, 0.4);
  }
  .formulario-index .form-status.success {
    color: rgba(253, 224, 71, 0.9);
  }
  .formulario-index .form-status.error {
    color: rgba(255, 255, 255, 0.55);
  }
</style>

<script>
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"
  import { SplitText } from "gsap/SplitText"

  gsap.registerPlugin(ScrollTrigger, SplitText)

  const page = document.getElementById("formulario-index")
  if (page) {
    gsap.context(() => {
      const mm = gsap.matchMedia()

      // ── Usuario con prefers-reduced-motion: todo estático ──
      mm.add("(prefers-reduced-motion: reduce)", () => {
        return () => {}
      })

      // ── Motion completo (solo si el usuario no pidió reducirlo) ──
      mm.add("(prefers-reduced-motion: no-preference)", () => {
        // Split del título por caracteres, enmascarado por línea
        const split = new SplitText("#formulario-index-title", {
          type: "chars,lines",
          charsClass: "split-char",
          linesClass: "split-line",
        })

        // Parallax de la capa ASCII
        gsap.fromTo(
          "[data-ascii]",
          { yPercent: 15 },
          {
            yPercent: -15,
            ease: "none",
            scrollTrigger: {
              trigger: page,
              start: "top bottom",
              end: "bottom top",
              scrub: true,
            },
          }
        )

        // Coreografía de entrada
        const tl = gsap.timeline({
          scrollTrigger: { trigger: page, start: "top 72%" },
        })

        tl.from(".split-char", {
            yPercent: 110,
            rotation: 6,
            autoAlpha: 0,
            duration: 0.65,
            stagger: 0.02,
            ease: "power3.out",
          })
          .from(
            "[data-anim]",
            {
              y: 26,
              autoAlpha: 0,
              duration: 0.6,
              stagger: 0.1,
              ease: "power3.out",
            },
            0.35
          )
          .from(
            "[data-field]",
            {
              y: 30,
              autoAlpha: 0,
              duration: 0.6,
              stagger: 0.09,
              ease: "power3.out",
            },
            0.6
          )
          .from(
            "[data-sticker]",
            {
              scale: 0,
              rotation: -30,
              autoAlpha: 0,
              duration: 0.5,
              ease: "back.out(2)",
            },
            1.0
          )

        // Flotación del sticker (solo desktop)
        const isDesktop = window.matchMedia("(min-width: 1024px)").matches
        if (isDesktop) {
          gsap.to("[data-sticker]", {
            y: 12,
            rotation: 4,
            duration: 2.6,
            yoyo: true,
            repeat: -1,
            ease: "sine.inOut",
            delay: 2,
          })
        }

        return () => {
          split.revert()
        }
      })
    }, page)
  }

  // ── Formulario: envío por fetch sin recarga ──
  const form = document.getElementById("contact-form")
  if (form) {
    const status = document.getElementById("form-status")
    const submitBtn = document.getElementById("form-submit")
    const SENDING = "[ Transmitiendo... ]"
    const SEND = "[ Transmitir mensaje → ]"

    const setStatus = (text, kind) => {
      if (!status) return
      status.textContent = text
      status.className = kind ? `form-status ${kind}` : "form-status"
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault()

      const formData = new FormData(form)
      const name = formData.get("name")?.trim()
      const email = formData.get("email")?.trim()
      const message = formData.get("message")?.trim()

      if (
        !name ||
        name.length < 2 ||
        !email ||
        !email.includes("@") ||
        !message ||
        message.length < 5
      ) {
        setStatus("!! error de transmisión — completá todos los campos", "error")
        return
      }

      setStatus("// estableciendo señal...", "loading")
      if (submitBtn) {
        submitBtn.disabled = true
        submitBtn.innerHTML = SENDING
      }

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name, email, message }),
        })

        const result = await res.json()

        if (result.success) {
          setStatus("// señal recibida — respondemos pronto", "success")
          form.reset()
        } else {
          setStatus("!! error de transmisión — intentá de nuevo", "error")
        }
      } catch {
        setStatus("!! error de transmisión — intentá de nuevo", "error")
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false
          submitBtn.innerHTML = SEND
        }
      }
    })
  }
</script>
