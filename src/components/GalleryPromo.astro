---
/**
 * GalleryPromo — Sección Home · Puerta de entrada a /gallery
 *
 * Estética Y2K Brutalista (tokens + neon), calcada del patrón FAQ/Pricing:
 *   - Header editorial: eyebrow mono neon + título gigante fluido
 *   - Preview curada: 3 obras desde src/data/gallery.ts (fuente única de verdad)
 *   - CTA bordeado → /gallery (hover: bg-neon)
 *
 * Motion: script propio scoped con gsap.matchMedia (progressive enhancement:
 * sin JS o con prefers-reduced-motion todo es visible).
 */
import { gallery } from "@/data/gallery";
import type { GalleryItem } from "@/data/gallery";

// Curaduría fija por id (orden predecible). El test PRD-007 valida que
// cada id exista en la colección de gallery.ts.
const previewIds = ["ic-caratula", "deriva-generativa", "wordmark-lllit"];

const preview = previewIds
  .map((id) => gallery.find((item) => item.id === id))
  .filter((item): item is GalleryItem => Boolean(item));

const isSvg = (src: string) => src.endsWith(".svg");
---

<section
  id="galeria"
  class="bg-[var(--surface)] text-[var(--ink)] px-5 sm:px-8 py-20 sm:py-28"
>
  <div class="mx-auto max-w-6xl">
    <!-- Header editorial -->
    <header class="border-b-2 border-[var(--line)] pb-8">
      <div class="flex items-center justify-between gap-4">
        <p class="font-mono text-[10px] font-bold uppercase tracking-[0.25em] text-neon">
          [ Galería / Arte ]
        </p>
        <p
          class="hidden font-mono text-[10px] uppercase tracking-[0.25em] text-[var(--muted)] sm:block"
        >
          {gallery.length} obras · imagen · video
        </p>
      </div>
      <h2
        id="gallery-title"
        class="mt-5 text-[clamp(2.25rem,7vw,4.5rem)] font-bold uppercase leading-[0.9] tracking-tighter"
      >
        Obras<span class="text-neon">.</span>
      </h2>
    </header>

    <!-- Preview curada: 3 piezas de la colección -->
    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-3">
      {
        preview.map((item, i) => (
          <a
            href="/gallery"
            aria-label={`Ver ${item.title} en la galería`}
            class="gallery-tile group block border-2 border-[var(--line)] bg-[#0a0a0a] text-white"
          >
            <div class="overflow-hidden" style="aspect-ratio: 1 / 1">
              {isSvg(item.src) ? (
                <img
                  src={item.src}
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-contain p-8 transition-transform duration-300 group-hover:scale-[1.04] sm:p-10"
                />
              ) : (
                <img
                  src={item.srcWebp ?? item.src}
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.04]"
                />
              )}
            </div>
            <div class="flex items-center justify-between gap-3 border-t-2 border-[var(--line)] px-4 py-3">
              <span class="truncate font-mono text-[10px] font-bold uppercase tracking-[0.18em]">
                <span class="text-neon">[{String(i + 1).padStart(2, "0")}]</span> {item.title}
              </span>
              <span
                class="shrink-0 text-white/70 transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <!-- CTA -->
    <div class="mt-10 border-2 border-[var(--line)]">
      <a
        href="/gallery"
        class="gallery-cta group flex items-center justify-between gap-4 px-5 py-4 font-mono text-xs sm:text-sm font-bold uppercase tracking-widest transition-colors duration-150 hover:bg-neon hover:text-black"
      >
        <span>Entrar a la galería</span>
        <span
          class="transition-transform duration-150 group-hover:translate-x-1"
          aria-hidden="true">→</span
        >
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import SplitType from "split-type";

  gsap.registerPlugin(ScrollTrigger);

  // Galería — coreografía propia, scoped a esta sección.
  // Con prefers-reduced-motion: reduce no se oculta nada (progressive enhancement).
  const galleryEl = document.getElementById("galeria");
  if (galleryEl && window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      // Título: revelado por caracteres, el punto se mantiene en neon.
      const titleSplit = new SplitType("#gallery-title", { types: "chars" });
      titleSplit.chars.forEach((char) => {
        if (char.textContent === ".") char.classList.add("text-neon");
      });

      gsap.from(titleSplit.chars, {
        yPercent: 110,
        autoAlpha: 0,
        duration: 0.65,
        stagger: 0.02,
        ease: "power3.out",
        scrollTrigger: {
          trigger: galleryEl,
          start: "top 75%",
          toggleActions: "play none none none",
        },
      });

      // Tiles: entrada escalonada.
      gsap.from(".gallery-tile", {
        y: 24,
        autoAlpha: 0,
        duration: 0.55,
        stagger: 0.08,
        ease: "power2.out",
        scrollTrigger: {
          trigger: galleryEl,
          start: "top 65%",
          toggleActions: "play none none none",
        },
      });

      // CTA.
      gsap.from(".gallery-cta", {
        y: 16,
        autoAlpha: 0,
        duration: 0.5,
        ease: "power2.out",
        scrollTrigger: {
          trigger: ".gallery-cta",
          start: "top 92%",
          toggleActions: "play none none none",
        },
      });

      return () => titleSplit.revert();
    });
  }
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    .gallery-tile span,
    .gallery-cta span {
      transition: none;
    }
  }
</style>
