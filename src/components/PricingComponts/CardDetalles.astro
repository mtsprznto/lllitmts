---
/**
 * CardDetalles — Card de precio, estética Y2K Brutalista.
 * Marco chunky (border-2 + sombra dura) que "se levanta" en hover,
 * filas de detalle con labels mono, precio destacado y CTA a /formulario.
 * Props:
 *  - title: string       (nombre del plan)
 *  - detalle: string     (descripción del servicio)
 *  - hardware: string    (equipo incluido)
 *  - proyector: string   (proyector incluido o "No incluye proyector")
 *  - precio: string      (ej. "$70.000")
 *  - index?: number      (índice [01] para numeración por columna)
 *  - href?: string       (destino del CTA; default /formulario)
 */
interface Props {
  title: string;
  detalle: string;
  hardware: string;
  proyector: string;
  precio: string;
  index?: number;
  href?: string;
}

const {
  title,
  detalle,
  hardware,
  proyector,
  precio,
  index = 0,
  href = "/formulario",
} = Astro.props;

const pad = (n: number) => String(n).padStart(2, "0");
const isLiveVj = /live\s*vj/i.test(detalle);
---

<article data-price-card class="price-card relative border-2 border-[var(--line)] bg-[var(--surface)]">
  <!-- Header: título + índice -->
  <header class="flex items-center justify-between gap-3 border-b-2 border-[var(--line)] px-4 py-3">
    <h3 class="min-w-0 font-bold uppercase leading-tight tracking-tight text-[var(--ink)] text-base sm:text-lg">
      {title}
    </h3>
    <span class="shrink-0 font-mono text-xs font-bold uppercase tabular-nums text-neon">
      [{pad(index)}]
    </span>
  </header>

  <!-- Filas de detalle -->
  <dl class="px-4 py-1 font-mono text-[0.7rem] sm:text-xs uppercase tracking-widest">
    <div class="flex flex-col gap-1 border-b border-[var(--line)] py-2.5 sm:flex-row sm:items-baseline sm:gap-4">
      <dt class="shrink-0 text-[var(--muted)] sm:w-28">Detalle</dt>
      <dd class="min-w-0 text-[var(--ink)] leading-snug break-words">{detalle}</dd>
    </div>
    <div class="flex flex-col gap-1 border-b border-[var(--line)] py-2.5 sm:flex-row sm:items-baseline sm:gap-4">
      <dt class="shrink-0 text-[var(--muted)] sm:w-28">Hardware</dt>
      <dd class="min-w-0 text-[var(--ink)] leading-snug break-words">{hardware}</dd>
    </div>
    <div class="flex flex-col gap-1 py-2.5 sm:flex-row sm:items-baseline sm:gap-4">
      <dt class="shrink-0 text-[var(--muted)] sm:w-28">Proyector</dt>
      <dd class="min-w-0 text-[var(--ink)] leading-snug break-words">{proyector}</dd>
    </div>
  </dl>

  <!-- Footer: precio + badge live + CTA -->
  <footer>
    <div class="flex items-end justify-between gap-4 px-4 pt-3">
      <div>
        <p class="font-mono text-[0.6rem] font-bold uppercase tracking-widest text-[var(--muted)]">
          Precio
        </p>
        <p class="mt-1 font-bold leading-none tracking-tighter text-[var(--ink)] text-2xl sm:text-3xl">
          {precio}
        </p>
      </div>
      {isLiveVj && (
        <span
          class="inline-block rotate-3 bg-neon text-black border-2 border-black px-2 py-0.5 font-mono text-[0.6rem] font-bold uppercase tracking-widest shadow-[2px_2px_0_#000]"
        >
          ● Live VJ
        </span>
      )}
    </div>
    <a
      href={href}
      class="mt-3 flex items-center justify-between gap-2 border-t-2 border-[var(--line)] px-4 py-2.5 font-mono text-[0.7rem] font-bold uppercase tracking-widest text-[var(--ink)] transition-colors duration-150 hover:bg-neon hover:text-black"
    >
      <span>Reservar</span>
      <span aria-hidden="true">→</span>
    </a>
  </footer>
</article>

<style>
  .price-card {
    box-shadow: 6px 6px 0 #000;
    transition:
      transform 150ms ease,
      box-shadow 150ms ease;
  }
  .price-card:hover,
  .price-card:focus-within {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 var(--color-neon);
  }

  @media (prefers-reduced-motion: reduce) {
    .price-card {
      transition: none;
    }
  }
</style>
